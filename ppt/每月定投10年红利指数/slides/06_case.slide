      <Box style={{ flex: 1, background: '#EEF2F7', borderRadius: 14, padding: 22 }}>
        <Text style={{ fontSize: 20, color: '#6B7686' }}>上证红利（同期最深）</Text>
        <Text style={{ fontSize: 38, fontWeight: 'bold', color: '#C0392B' }}>-¥149,055</Text>
        <Text style={{ fontSize: 15, color: '#6B7686' }}>-17.06% · 2022-04-06 收复</Text>
